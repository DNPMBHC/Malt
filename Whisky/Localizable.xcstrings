        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거의 다 왔어요. 아직 끄지 마세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijna daar. Nog niet weg gaan."
