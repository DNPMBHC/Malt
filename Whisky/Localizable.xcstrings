    "runtime.profile.embark-the-finals": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easy Anti-Cheat support depends on the game publisher. This runtime cannot enable or emulate publisher components."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Easy Anti-Cheat 支持取决于游戏发行商。此运行时无法启用或模拟发行商组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Easy Anti-Cheat 支援取決於遊戲發行商。此執行環境無法啟用或模擬發行商元件。"
          }
        }
      }
    },
    "runtime.profile.riot-league-of-legends": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile refers to the Windows client. The separate native macOS client is outside this Windows runtime path."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此档案仅适用于 Windows 客户端。原生 macOS 客户端有独立的运行方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此設定檔僅適用於 Windows 用戶端。原生 macOS 用戶端有獨立的執行方式。"
          }
        }
      }
    },
    "runtime.profile.riot-valorant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Windows build depends on a kernel-level anti-cheat path. A guest must be supported by the game vendor and configured as a real Windows environment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 版本依赖内核层反作弊。来宾系统须由游戏厂商支持，并且必须是实际运行的 Windows 环境。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 版本仰賴核心層反外掛機制。客體系統須獲遊戲廠商支援，並且必須是真正執行的 Windows 環境。"
          }
        }
      }
    },
