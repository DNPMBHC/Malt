    "settings.matrix.woaSplitNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VALORANT (CN ACE & Global Vanguard On-Demand) orthogonally splits Axis 1 (Bare-Metal Windows on ARM native ARM64 driver availability with Prism AVX/AVX2) from Axis 2 (Virtualized ARM64 Guest Hypervisor / vTPM / VBS policy)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已针对 VALORANT（国服 ACE + 国际服 Vanguard On-Demand）正交拆分「轴 1：裸金属 Windows on ARM 驱动可用性（Prism AVX/AVX2 + 原生 ARM64 驱动）」与「轴 2：虚拟化 ARM64 Guest 策略（Hypervisor / vTPM / VBS 限制）」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已針對 VALORANT（國服 ACE + 國際服 Vanguard On-Demand）正交拆分「軸 1：裸金屬 Windows on ARM 驅動可用性（Prism AVX/AVX2 + 原生 ARM64 驅動）」與「軸 2：虛擬化 ARM64 Guest 策略（Hypervisor / vTPM / VBS 限制）」。"
          }
        }
      }
    },
