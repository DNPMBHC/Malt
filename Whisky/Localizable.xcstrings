    },
    "disclaimer.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please read and confirm the following terms before using Whisky_new"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Whisky_new 前请仔细阅读并确认遵守以下合规条款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Whisky_new 前請仔細閱讀並確認遵守以下合規條款"
          }
        }
      }
    },
    "disclaimer.clause1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawful Research & Licensed Software Scope"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合法研究与正版软件使用范围"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合法研究與正版軟體使用範圍"
          }
        }
      }
    },
    "disclaimer.clause1.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This project (Whisky_new) is an open-source compatibility research, runtime orchestration, and graphics translation framework for macOS (Apple Silicon). It is strictly intended for lawful technical research, open-source software development, and running operating systems, software, and games for which you hold valid licenses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本项目（Whisky_new）是一款面向 macOS（Apple Silicon）的开源兼容性研究、游戏运行调度与图形转译框架，仅限用于合法技术研究、开源软件开发以及运行用户拥有合法授权的操作系统与软件/游戏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本專案（Whisky_new）是一款面向 macOS（Apple Silicon）的開源相容性研究、遊戲執行調度與圖形轉譯框架，僅限用於合法技術研究、開源軟體開發以及執行使用者擁有合法授權的作業系統與軟體/遊戲。"
          }
        }
      }
    },
    "disclaimer.clause2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero Tolerance for Cheating & Anti-Cheat Abuse"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严禁滥用与反作弊安全红线"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嚴禁濫用與反作弊安全紅線"
          }
        }
      }
    },
    "disclaimer.clause2.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using this project, its source code, or its build artifacts—directly or indirectly—to develop, distribute, or assist any game cheats, memory tampers, aimbots, macro scripts, hardware spoofers, or to circumvent,对抗, or undermine any anti-cheat system or DRM mechanism is strictly prohibited."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "严禁任何人直接或间接地利用本项目、其源代码或构建产物制作、分发或辅助任何游戏外挂、作弊软件、内存修改器、自动化脚本、硬件伪造工具，或用于规避、对抗、破坏任何反作弊系统与数字版权保护（DRM）机制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嚴禁任何人直接或間接地利用本專案、其原始碼或建置產物製作、分發或輔助任何遊戲外掛、作弊軟體、記憶體修改器、自動化腳本、硬體偽造工具，或用於規避、對抗、破壞任何反作弊系統與數位版權保護（DRM）機制。"
          }
        }
      }
    },
    "disclaimer.clause3.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Respect for Platform & Publisher Terms"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尊重平台与厂商服务条款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尊重平台與廠商服務條款"
          }
        }
      }
    },
    "disclaimer.clause3.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This project provides no anti-cheat bypass or virtualization-hiding features. Before running any third-party game, launcher, or Windows OS, you must ensure you hold valid licenses and strictly comply with the EULA and Terms of Service (ToS) of the respective game publishers and anti-cheat vendors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本项目绝不提供任何反作弊绕过或虚拟化隐藏功能。用户在运行任何第三方游戏、启动器或 Windows 操作系统前，必须自行确保已获得合法软件授权，并严格遵守对应游戏发行商与反作弊厂商的最终用户许可协议（EULA）及服务条款（ToS）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本專案絕不提供任何反作弊繞過或虛擬化隱藏功能。使用者在執行任何第三方遊戲、啟動器或 Windows 作業系統前，必須自行確保已取得合法軟體授權，並嚴格遵守對應遊戲發行商與反作弊廠商的最終使用者許可協議（EULA）及服務條款（ToS）。"
          }
        }
      }
    },
    "disclaimer.clause4.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AS-IS Provision & Limitation of Liability"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现状提供与责任限制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現狀提供與責任限制"
          }
        }
      }
    },
    "disclaimer.clause4.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This software is provided \"AS IS\" without warranty of any kind. The authors and contributors assume no direct or indirect liability for account restrictions, bans, data loss, hardware/system issues, or legal/economic damages resulting from private code modifications, ToS violations, or running in unsupported virtualized/translated environments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本软件按“现状（AS IS）”提供，不附带任何明示或暗示的担保（包括但不限于兼容性、稳定性或在线服务可用性）。因用户私自修改源代码、违反第三方厂商服务条款、或在厂商明确不支持/禁止虚拟化或转译的环境中强行运行所导致的账号限制、封禁、数据丢失、硬件/系统异常或其他法律与经济损失，本项目作者及所有贡献者不承担任何直接或间接责任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本軟體按「現狀（AS IS）」提供，不附帶任何明示或暗示的擔保（包括但不限於相容性、穩定性或線上服務可用性）。因使用者私自修改原始碼、違反第三方廠商服務條款、或在廠商明確不支援/禁止虛擬化或轉譯的環境中強行執行所導致的帳號限制、封禁、資料遺失、硬體/系統異常或其他法律與經濟損失，本專案作者及所有貢獻者不承擔任何直接或間接責任。"
          }
        }
      }
    },
    "disclaimer.openSourceBoundary.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Honest Single-Sided Open-Source Boundary"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单边开源安全物理边界说明"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單邊開源安全物理邊界說明"
          }
        }
      }
    },
    "disclaimer.openSourceBoundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardened Runtime protects official signed builds against external process injection while macOS SIP is enabled; single-sided open source cannot physically prevent private rebuilds when SIP is disabled—full anti-tamper assurance requires cryptographic remote attestation with anti-cheat servers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardened Runtime 仅在宿主机开启 macOS SIP 且运行官方签名构建时防止外部进程寄生；单边开源无法在物理上阻止关闭 SIP 后的私有魔改重编译，完整防篡改闭环须由反作弊服务端通过密码学远程证明协同校验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardened Runtime 僅在宿主機開啟 macOS SIP 且執行官方簽章建置時防止外部行程寄生；單邊開源無法在物理上阻止關閉 SIP 後的私有魔改重編譯，完整防竄改閉環須由反作弊伺服端透過密碼學遠端證明協同校驗。"
          }
        }
      }
    },
