    "config.graphicsBackend.fallbackAlert.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preferred graphics backend is unavailable, so routing fell back to an alternate engine. Install the locked DXMT / D3DMetal components in Settings to avoid silent performance loss."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首选图形转译引擎缺失，已自动回落至备选引擎。为避免性能损失，请在「设置 → 运行时版本锁死清单」核验并补齐锁定版本的 DXMT / D3DMetal 组件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首選圖形轉譯引擎缺失，已自動回落至備選引擎。為避免效能損失，請在「設定 → 執行期版本鎖定清單」核驗並補齊鎖定版本的 DXMT / D3DMetal 元件。"
          }
        }
      }
    },
    "config.graphicsBackend.missingAlert.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
