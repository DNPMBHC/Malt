          "stringUnit": {
            "state": "translated",
            "value": "自动识别检查所选文件及其链接目标的名称。对于脚本、启动器或平台客户端，请选择它将启动的游戏，或确认它是普通程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
