      }
    },
    "config.adaptiveResourcePolicy.info": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under thermal pressure or Low Power Mode, non-destructively applies frame-rate caps for DXMT (DXMT_CONFIG / DXMT_METALFX_SPATIAL_SWAPCHAIN) and DXVK (DXVK_FRAME_RATE / DXVK_NUM_COMPILER_THREADS) plus lower Wine QoS without overriding your custom environment variables. D3DMetal has no public throttling variables."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在发热受限或低电量模式下，以非破坏性方式为 DXMT（DXMT_CONFIG / DXMT_METALFX_SPATIAL_SWAPCHAIN）与 DXVK（DXVK_FRAME_RATE / DXVK_NUM_COMPILER_THREADS）施加限帧策略并降低 Wine 进程 QoS，不会覆盖你手动配置的环境变量；D3DMetal 无公开限帧变量，保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在發熱受限或低電量模式下，以非破壞性方式為 DXMT（DXMT_CONFIG / DXMT_METALFX_SPATIAL_SWAPCHAIN）與 DXVK（DXVK_FRAME_RATE / DXVK_NUM_COMPILER_THREADS）套用限影格策略並降低 Wine 進程 QoS，不會覆蓋你手動設定的環境變數；D3DMetal 無公開限影格變數，保持原樣。"
          }
        }
      }
    },
