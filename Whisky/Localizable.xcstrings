    "config.adaptiveResourcePolicy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaptive Host Resource Policy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用宿主自适应资源策略"
          }
        },
        "zh-Hant": {
