    "setup.rosetta.fail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تثبيت Rosetta 2. الرجاء تثبيته يدوياً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
