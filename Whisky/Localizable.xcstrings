    "disclaimer.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legal & Anti-Cheat Compliance Disclaimer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
