    "setup.whiskywine.install.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اوشكت على الوصول. لا تضبط الخروج بعد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
