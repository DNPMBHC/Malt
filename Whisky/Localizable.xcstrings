    "config.dxmt.metalFX.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the game target output height accurately. Upscaling increases VRAM and cold initialization time; it is disabled below 1080p or under thermal/power pressure."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请准确设置游戏目标输出高度。超分会增加显存与冷启动耗时；目标低于 1080p 或存在温度/电源压力时自动关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請準確設定遊戲目標輸出高度。超解析會增加顯存與冷啟動耗時；目標低於 1080p 或存在溫度/電源壓力時自動關閉。"
          }
        }
      }
    },
