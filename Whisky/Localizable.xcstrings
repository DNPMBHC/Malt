    "runtime.complianceBanner.detailsButton": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disclaimer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免责声明"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免責聲明"
          }
        }
      }
    },
    "runtime.complianceBanner.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile involves kernel-level anti-cheat or an experimental Windows Guest path. Platform and virtualization identities are reported honestly without spoofing. Readiness or diagnostic probe checks do NOT imply publisher authorization or online protected-session support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前档案涉及内核级反作弊或实验性 Windows Guest 路径。本框架诚实暴露真实平台与虚拟化身份，绝不隐藏或伪造。后端就绪或自有探针通过不代表获得发行方许可，亦不代表支持受保护在线对局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前檔案涉及核心級反作弊或實驗性 Windows Guest 路徑。本框架誠實暴露真實平台與虛擬化身分，絕不隱藏或偽造。後端就緒或自有探針通過不代表取得發行方許可，亦不代表支援受保護線上對局。"
          }
        }
      }
    },
