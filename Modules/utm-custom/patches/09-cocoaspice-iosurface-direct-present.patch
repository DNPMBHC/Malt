+                             sourceSize:MTLSizeMake(srcTexture.width, srcTexture.height, 1)
+                              toTexture:dstTexture
+                       destinationSlice:0
+                       destinationLevel:0
+                      destinationOrigin:MTLOriginMake(0, 0, 0)];
+            [directBlit endEncoding];
+            return YES;
+        }
+    }
