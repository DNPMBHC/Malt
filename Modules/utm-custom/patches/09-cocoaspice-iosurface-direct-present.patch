     g_assert(CSMain.sharedInstance.isCurrentContextMain);
     id<MTLTexture> source = self.glTexture;
-    id<MTLTexture> destination = self.shadowTexture;
     id<MTLCommandQueue> queue = self.renderers.firstObject.commandQueue;
+    if ([CSDisplay isIOSurfaceDirectPresentEnabled] && self.ready && source) {
+        // Zero-copy IOSurface direct present: omit the 32 MiB shadowTexture blit
+        // entirely, and synchronize with any prior queued Metal draw via a zero-byte
+        // FIFO fence command buffer so gl_draw_done never stalls on DisplayLink/TDR.
+        self.presentTexture = nil;
+        id<MTLCommandBuffer> fenceBuffer = queue ? [queue commandBuffer] : nil;
+        if (fenceBuffer != nil) {
+            fenceBuffer.label = @"IOSurface Direct Present Zero-Copy Fence";
+            [fenceBuffer addCompletedHandler:^(id<MTLCommandBuffer> completed) {
+                (void)completed;
+                [CSMain.sharedInstance asyncWith:completion];
+            }];
+            [fenceBuffer commit];
+        } else {
+            completion();
+        }
+        return;
+    }
+    id<MTLTexture> destination = self.shadowTexture;
     id<MTLCommandBuffer> commandBuffer = nil;
     id<MTLBlitCommandEncoder> blitEncoder = nil;
 
