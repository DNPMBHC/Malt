     self.shadowNeedsFullCopy = YES;
 }
 
++ (BOOL)isIOSurfaceDirectPresentEnabled {
+    NSString *env = NSProcessInfo.processInfo.environment[@"UTM_IOSURFACE_DIRECT_PRESENT"];
+    if (env.length > 0 && [env isEqualToString:@"0"]) {
+        return NO;
+    }
+    return ![NSProcessInfo.processInfo.arguments containsObject:@"--disable-iosurface-direct-present"];
+}
+
 /// Allocate the private texture the scanout is copied into. See
