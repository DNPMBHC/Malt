@@ -395,6 +395,42 @@ - (BOOL)_renderCommand:(id<MTLCommandBuffer>)commandBuffer
           viewportSize:(vector_uint2)viewportSize
                sampler:(id<MTLSamplerState>)sampler
   renderPassDescriptor:(MTLRenderPassDescriptor *)renderPassDescriptor {
+    NSString *directEnv = NSProcessInfo.processInfo.environment[@"UTM_IOSURFACE_DIRECT_PRESENT"];
+    BOOL directEnabled = !(directEnv.length > 0 && [directEnv isEqualToString:@"0"])
+        && ![NSProcessInfo.processInfo.arguments containsObject:@"--disable-iosurface-direct-present"];
+    id<MTLTexture> dstTexture = renderPassDescriptor.colorAttachments[0].texture;
