+        && !source.isInverted
+        && srcTexture != nil
+        && dstTexture != nil
+        && fabs(viewportScale - 1.0) < 0.001
+        && fabs(origin.x) < 0.5
+        && fabs(origin.y) < 0.5
+        && srcTexture.width == dstTexture.width
