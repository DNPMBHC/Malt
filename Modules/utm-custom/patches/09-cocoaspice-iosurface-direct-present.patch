+- (void)recordPresentAckMicros:(uint64_t)ackMicros modeLabel:(NSString *)modeLabel {
+    self.telemetryScanoutCount += 1;
+    self.telemetryAckTotalMicros += ackMicros;
+    CFTimeInterval now = CACurrentMediaTime();
+    if (self.telemetryLastReportTime <= 0.0) {
+        self.telemetryLastReportTime = now;
+        return;
+    }
+    CFTimeInterval elapsed = now - self.telemetryLastReportTime;
+    if (elapsed >= 5.0 && self.telemetryScanoutCount > 0) {
+        double scanoutFps = (double)self.telemetryScanoutCount / elapsed;
+        double ackUsAvg = (double)self.telemetryAckTotalMicros / (double)self.telemetryScanoutCount;
+        NSString *line = [NSString stringWithFormat:@"[Malt-Present] mode=%@ scanout_fps=%.2f ack_us_avg=%.1f frames=%llu\n",
+                          modeLabel, scanoutFps, ackUsAvg, (unsigned long long)self.telemetryScanoutCount];
+        [CSDisplay appendPresentTelemetryLine:line];
+        self.telemetryScanoutCount = 0;
+        self.telemetryAckTotalMicros = 0;
+        self.telemetryLastReportTime = now;
+    }
+}
