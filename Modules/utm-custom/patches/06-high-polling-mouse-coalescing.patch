 import Carbon.HIToolbox
+import CocoaSpice
+import GameController
+import os.lock
+
+private final class MaltRawMouseBridge: @unchecked Sendable {
+    private var lock = os_unfair_lock()
+    private weak var spiceInput: CSInput?
+    private weak var spiceDisplay: CSDisplay?
+    private var monitorID: Int = 0
+    private var buttonMask: CSInputButton = []
+    private var isCaptured: Bool = false
+    private var isRawActive: Bool = false
+
+    func configure(input: CSInput?, display: CSDisplay?) {
+        os_unfair_lock_lock(&lock)
+        spiceInput = input
+        spiceDisplay = display
+        monitorID = display?.monitorID ?? 0
+        os_unfair_lock_unlock(&lock)
+    }
+
+    func setCaptured(_ captured: Bool) {
+        os_unfair_lock_lock(&lock)
+        isCaptured = captured
+        if !captured { isRawActive = false; buttonMask = [] }
+        os_unfair_lock_unlock(&lock)
+    }
+
+    func setRawActive(_ active: Bool) {
+        os_unfair_lock_lock(&lock)
+        isRawActive = active
+        os_unfair_lock_unlock(&lock)
+    }
+
+    func getRawActive() -> Bool {
+        os_unfair_lock_lock(&lock)
+        let active = isRawActive
+        os_unfair_lock_unlock(&lock)
+        return active
+    }
+
+    func updateButtonMask(_ mask: CSInputButton) {
+        os_unfair_lock_lock(&lock)
+        buttonMask = mask
+        os_unfair_lock_unlock(&lock)
+    }
+
+    func dispatchRawDelta(dx: Float, dy: Float) {
+        guard dx != 0 || dy != 0 else { return }
+        os_unfair_lock_lock(&lock)
+        let captured = isCaptured
+        let input = spiceInput
+        let display = spiceDisplay
+        let monitor = display?.monitorID ?? monitorID
+        let mask = buttonMask
+        os_unfair_lock_unlock(&lock)
+        guard captured, let input = input else { return }
+        // GCMouse deltaY is positive upward; Windows/SPICE Y-axis is positive downward.
+        let delta = CGPoint(x: CGFloat(dx), y: CGFloat(-dy))
+        input.sendMouseMotion(mask, relativePoint: delta, forMonitorID: monitor)
+        display?.cursor?.applyRelativeFallback(delta: delta)
+    }
+}
 
