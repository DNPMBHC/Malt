+    }
+
+    private func enqueueRelativeMotion(dx: CGFloat, dy: CGFloat, buttonMask: CSInputButton) {
+        guard dx != 0 || dy != 0 else {
+            return
+        }
+        if mouseCoalesceWindowNs == 0 {
+            lastRelativeMotionSendNs = DispatchTime.now().uptimeNanoseconds
+            inputDelegate?.mouseMove(relativePoint: CGPoint(x: dx, y: dy), buttonMask: buttonMask)
+            return
+        }
+        pendingRelativeDeltaX += dx
+        pendingRelativeDeltaY += dy
+        pendingRelativeButtonMask = buttonMask
+        let now = DispatchTime.now().uptimeNanoseconds
+        if lastRelativeMotionSendNs == 0 || now &- lastRelativeMotionSendNs >= mouseCoalesceWindowNs {
+            flushPendingRelativeMotion()
+            return
+        }
+        if relativeMotionFlushTimer == nil {
+            let remainingNs = mouseCoalesceWindowNs - (now &- lastRelativeMotionSendNs)
+            let timer = DispatchSource.makeTimerSource(queue: .main)
+            timer.schedule(deadline: .now() + .nanoseconds(Int(remainingNs)), leeway: .microseconds(200))
+            timer.setEventHandler { [weak self] in
+                self?.flushPendingRelativeMotion()
+            }
+            relativeMotionFlushTimer = timer
+            timer.resume()
+        }
+    }
