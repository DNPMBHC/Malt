+    private func flushPendingRelativeMotion() {
+        if let timer = relativeMotionFlushTimer {
+            timer.cancel()
+            relativeMotionFlushTimer = nil
+        }
+        guard pendingRelativeDeltaX != 0 || pendingRelativeDeltaY != 0 else {
+            return
+        }
+        let dx = pendingRelativeDeltaX
