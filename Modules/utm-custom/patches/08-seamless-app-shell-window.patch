+// MARK: - Seamless App Shell Launch (--app-shell-vm)
+
+@MainActor
+private final class UTMAppShellLaunchCoordinator {
+    static let shared = UTMAppShellLaunchCoordinator()
+
+    private var launchObserver: NSObjectProtocol?
+    private var stopObserver: AnyCancellable?
+    private var hasStarted = false
+
+    static var requestedAppShellTarget: String? {
+        if let idx = CommandLine.arguments.firstIndex(of: "--app-shell-vm"),
+           idx + 1 < CommandLine.arguments.count {
+            return CommandLine.arguments[idx + 1]
+        }
+        if let env = ProcessInfo.processInfo.environment["UTM_APP_SHELL_VM"], !env.isEmpty {
+            return env
+        }
+        return nil
+    }
+
+    func register(delegate: AppDelegate) {
+        let disableScreenshot = ProcessInfo.processInfo.environment["UTM_DISABLE_SCREENSHOT"] == "1"
+            || Self.requestedAppShellTarget != nil
+            || CommandLine.arguments.contains("--game-shell-vm")
+            || ProcessInfo.processInfo.environment["UTM_GAME_SHELL_VM"] != nil
+        if disableScreenshot {
+            UserDefaults.standard.set(true, forKey: "NoScreenshot")
+        }
+        guard Self.requestedAppShellTarget != nil else {
+            return
+        }
+        if let existing = launchObserver {
+            NotificationCenter.default.removeObserver(existing)
+        }
+        launchObserver = NotificationCenter.default.addObserver(
+            forName: NSApplication.didFinishLaunchingNotification,
+            object: nil,
+            queue: .main
+        ) { [weak self, weak delegate] _ in
+            Task { @MainActor [weak self, weak delegate] in
+                guard let self = self,
+                      let delegate = delegate,
+                      let target = Self.requestedAppShellTarget,
+                      let data = delegate.data else {
+                    return
+                }
+                self.launchAppShellVM(target: target, data: data)
+            }
+        }
+    }
+
+    private func hideNonDisplayWindows(closeWindows: Bool) {
+        for window in NSApp.windows where !(window is VMDisplayWindow) {
+            window.orderOut(nil)
+            if closeWindows {
+                window.close()
+            }
+        }
+    }
+
+    private func launchAppShellVM(target: String, data: UTMData) {
+        hideNonDisplayWindows(closeWindows: false)
+        Task { @MainActor [weak self] in
+            guard let self = self else { return }
+            var vm: VMData?
+            if let uuid = UUID(uuidString: target) {
+                vm = data.virtualMachines.first(where: { $0.id == uuid })
+                if vm == nil {
+                    await data.listRefresh()
+                    vm = data.virtualMachines.first(where: { $0.id == uuid })
+                }
+            }
+            if vm == nil {
+                let candidateURL = URL(fileURLWithPath: target).standardizedFileURL.resolvingSymlinksInPath()
+                if FileManager.default.fileExists(atPath: candidateURL.path) {
+                    do {
+                        let candidate = try VMData(url: candidateURL)
+                        if let existing = data.virtualMachines.first(where: {
+                            $0.isLoaded && $0.pathUrl.standardizedFileURL.resolvingSymlinksInPath() == candidateURL
+                        }) {
+                            guard existing.id == candidate.id else {
+                                NSLog("[UTM-Custom] Refusing a stale VM registry identifier")
+                                return
+                            }
+                            vm = existing
+                        } else {
+                            guard !data.virtualMachines.contains(where: { $0.isLoaded && $0.id == candidate.id }) else {
+                                NSLog("[UTM-Custom] Refusing duplicate VM identifier from a different package")
+                                return
+                            }
+                            try await data.importUTM(from: candidateURL, asShortcut: true)
+                            vm = data.virtualMachines.first(where: {
+                                $0.isLoaded && $0.id == candidate.id &&
+                                $0.pathUrl.standardizedFileURL.resolvingSymlinksInPath() == candidateURL
+                            })
+                        }
+                    } catch {
+                        NSLog("[UTM-Custom] Unable to register shell VM: %@", error.localizedDescription)
+                        return
+                    }
+                }
+            }
+            guard let resolvedVM = vm else {
+                NSLog("[UTM-Custom] App shell target not found: %@", target)
+                return
+            }
+            self.hasStarted = false
+            self.stopObserver = resolvedVM.$state
+                .sink { [weak self] state in
+                    guard let self = self else { return }
+                    if state == .started {
+                        self.hasStarted = true
+                    } else if self.hasStarted && state == .stopped {
+                        DispatchQueue.main.async {
+                            NSApp.terminate(nil)
+                        }
+                    }
+                }
+            if CommandLine.arguments.contains("--app-shell-prepare-only") {
+                return
+            }
+            NSLog("[UTM-Custom] Launching app shell VM: %@", resolvedVM.id.uuidString)
+            data.run(vm: resolvedVM)
+            self.hideNonDisplayWindows(closeWindows: false)
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) { [weak self] in
+                self?.hideNonDisplayWindows(closeWindows: true)
+            }
+        }
+    }
+}
+
+private extension AppDelegate {
+    func registerAppShellLaunchObserverIfNeeded() {
+        UTMAppShellLaunchCoordinator.shared.register(delegate: self)
+    }
+}
