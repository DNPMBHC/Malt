+// MARK: - Seamless Dual-Form App Shell (--app-shell-vm)
+
+private enum UTMAppShellPhase: String {
+    case compact
+    case fullscreen
+    case exiting
+}
+
+@MainActor
+private final class UTMAppShellRuntimeState {
+    static let shared = UTMAppShellRuntimeState()
+
+    var currentPhase: UTMAppShellPhase = .compact
+    var statePollTimer: Timer?
+    var distributedObserver: NSObjectProtocol?
+    var usbTransferObserver: NSObjectProtocol?
+    var keyGuardMonitor: Any?
+    var lastObservedRawState: String = ""
+
+    static var isAppShellMode: Bool {
+        CommandLine.arguments.contains("--app-shell-vm")
+            || ProcessInfo.processInfo.environment["UTM_APP_SHELL_VM"] != nil
+    }
+
+    static var windowTitle: String {
+        if let idx = CommandLine.arguments.firstIndex(of: "--window-title"),
+           idx + 1 < CommandLine.arguments.count {
+            let value = CommandLine.arguments[idx + 1].trimmingCharacters(in: .whitespacesAndNewlines)
+            if !value.isEmpty {
+                return value
+            }
+        }
+        if let env = ProcessInfo.processInfo.environment["UTM_APP_SHELL_WINDOW_TITLE"],
+           !env.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
+            return env
+        }
+        return "Whisky App"
+    }
+
+    static var windowSize: CGSize {
+        let raw: String?
+        if let idx = CommandLine.arguments.firstIndex(of: "--window-size"),
+           idx + 1 < CommandLine.arguments.count {
+            raw = CommandLine.arguments[idx + 1]
+        } else {
+            raw = ProcessInfo.processInfo.environment["UTM_APP_SHELL_WINDOW_SIZE"]
+        }
+        if let raw = raw {
+            let normalized = raw.lowercased().replacingOccurrences(of: " ", with: "")
+            let parts = normalized.split(separator: "x")
+            if parts.count == 2,
+               let width = Double(parts[0]),
+               let height = Double(parts[1]),
+               width >= 320,
+               height >= 240 {
+                return CGSize(width: width, height: height)
+            }
+        }
+        return CGSize(width: 1024, height: 680)
+    }
+
+    static var stateFilePath: String? {
+        if let idx = CommandLine.arguments.firstIndex(of: "--app-shell-state-file"),
+           idx + 1 < CommandLine.arguments.count {
+            return CommandLine.arguments[idx + 1]
+        }
+        if let env = ProcessInfo.processInfo.environment["UTM_APP_SHELL_STATE_FILE"], !env.isEmpty {
+            return env
+        }
+        return nil
+    }
+
+    static func parseSignal(_ rawText: String) -> UTMAppShellPhase? {
+        let trimmed = rawText.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty else {
+            return nil
+        }
+        var token = trimmed.lowercased()
+        if token.hasPrefix("{"),
+           let data = trimmed.data(using: .utf8),
+           let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any] {
+            if let state = (json["state"] as? String) ?? (json["mode"] as? String) ?? (json["phase"] as? String) {
+                token = state.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+            }
+        }
+        switch token {
+        case "fullscreen", "game_foreground", "game-foreground", "game_active", "gameplay":
+            return .fullscreen
+        case "compact", "launcher", "installer", "windowed":
+            return .compact
+        case "exit", "exited", "quit", "stopped":
+            return .exiting
+        default:
+            return nil
+        }
+    }
+}
+
+private extension VMDisplayQemuMetalWindowController {
+    func configureAppShellWindowIfNeeded() {
+        guard UTMAppShellRuntimeState.isAppShellMode, let window = window else {
+            return
+        }
+        window.toolbar?.isVisible = true
+        window.title = UTMAppShellRuntimeState.windowTitle
+        window.titleVisibility = .visible
+        window.setContentSize(UTMAppShellRuntimeState.windowSize)
+        window.center()
+        window.makeKeyAndOrderFront(nil)
+        NSApp.activate(ignoringOtherApps: true)
+        installAppShellKeyGuardIfNeeded()
+        startAppShellStateMonitoring()
+    }
+
+    func startAppShellStateMonitoring() {
+        guard UTMAppShellRuntimeState.isAppShellMode else {
+            return
+        }
+        let runtime = UTMAppShellRuntimeState.shared
+        runtime.currentPhase = .compact
+        runtime.lastObservedRawState = ""
+
+        if let observer = runtime.distributedObserver {
+            DistributedNotificationCenter.default().removeObserver(observer)
+        }
+        runtime.distributedObserver = DistributedNotificationCenter.default().addObserver(
+            forName: Notification.Name("com.utmapp.utm.appShellStateChanged"),
+            object: nil,
+            queue: .main
+        ) { [weak self] notification in
+            let raw = (notification.userInfo?["state"] as? String)
+                ?? (notification.object as? String)
+                ?? ""
+            Task { @MainActor [weak self] in
+                self?.applyAppShellSignal(raw)
+            }
+        }
+
+        if let observer = runtime.usbTransferObserver {
+            DistributedNotificationCenter.default().removeObserver(observer)
+        }
+        runtime.usbTransferObserver = DistributedNotificationCenter.default().addObserver(
+            forName: Notification.Name("com.malt.virtualUsbTransfer"),
+            object: nil,
+            queue: .main
+        ) { [weak self] notification in
+            guard let payload = notification.object as? String else { return }
+            Task { @MainActor [weak self] in
+                await self?.handleVirtualUSBTransferNotification(payload)
+            }
+        }
+
+        runtime.statePollTimer?.invalidate()
+        if UTMAppShellRuntimeState.stateFilePath != nil {
+            runtime.statePollTimer = Timer.scheduledTimer(withTimeInterval: 0.25, repeats: true) { [weak self] _ in
+                Task { @MainActor [weak self] in
+                    self?.pollAppShellStateFile()
+                }
+            }
+        }
+    }
+
+    func stopAppShellStateMonitoring() {
+        let runtime = UTMAppShellRuntimeState.shared
+        runtime.statePollTimer?.invalidate()
+        runtime.statePollTimer = nil
+        if let observer = runtime.distributedObserver {
+            DistributedNotificationCenter.default().removeObserver(observer)
+            runtime.distributedObserver = nil
+        }
+        if let observer = runtime.usbTransferObserver {
+            DistributedNotificationCenter.default().removeObserver(observer)
+            runtime.usbTransferObserver = nil
+        }
+        if let monitor = runtime.keyGuardMonitor {
+            NSEvent.removeMonitor(monitor)
+            runtime.keyGuardMonitor = nil
+        }
+    }
+
+    func handleVirtualUSBTransferNotification(_ payload: String) async {
+        let parts = payload.split(separator: "|", omittingEmptySubsequences: false).map(String.init)
+        guard parts.count >= 2,
+              parts[1].caseInsensitiveCompare(qemuVM.id.uuidString) == .orderedSame else {
+            return
+        }
+        guard let removableDrive = qemuVM.config.drives.first(where: { $0.isExternal }) else {
+            logger.warning("Virtual USB transfer skipped: no removable drive slot configured")
+            return
+        }
+        switch parts[0] {
+        case "mount":
+            guard parts.count >= 3 else { return }
+            let filename = parts[2]
+            guard !filename.isEmpty, !filename.contains("/"), !filename.contains("..") else { return }
+            let isoURL = qemuVM.pathUrl.appendingPathComponent("Data").appendingPathComponent(filename)
+            guard FileManager.default.isReadableFile(atPath: isoURL.path) else { return }
+            try? await qemuVM.changeMedium(removableDrive, to: isoURL)
+        case "eject":
+            try? await qemuVM.eject(removableDrive)
+        default:
+            break
+        }
+    }
+
+    func pollAppShellStateFile() {
+        guard let path = UTMAppShellRuntimeState.stateFilePath,
+              let content = try? String(contentsOfFile: path, encoding: .utf8) else {
+            return
+        }
+        let runtime = UTMAppShellRuntimeState.shared
+        guard content != runtime.lastObservedRawState else {
+            return
+        }
+        runtime.lastObservedRawState = content
+        applyAppShellSignal(content)
+    }
+
+    func applyAppShellSignal(_ rawSignal: String) {
+        guard let phase = UTMAppShellRuntimeState.parseSignal(rawSignal) else {
+            return
+        }
+        let runtime = UTMAppShellRuntimeState.shared
+        guard phase != runtime.currentPhase else {
+            return
+        }
+        runtime.currentPhase = phase
+        switch phase {
+        case .fullscreen:
+            transitionAppShellToGameFullScreen()
+        case .compact:
+            transitionAppShellToCompactWindow()
+        case .exiting:
+            stopAppShellStateMonitoring()
+            NSApp.terminate(nil)
+        }
+    }
+
+    func transitionAppShellToGameFullScreen() {
+        guard let window = window else {
+            return
+        }
+        window.toolbar?.isVisible = true
+        window.titleVisibility = .visible
+        window.titlebarAppearsTransparent = false
+        window.styleMask.insert(.fullSizeContentView)
+        window.backgroundColor = .black
+        metalView.clearColor = MTLClearColor(red: 0, green: 0, blue: 0, alpha: 1)
+        installAppShellKeyGuardIfNeeded()
+        NSApp.activate(ignoringOtherApps: true)
+        window.makeKeyAndOrderFront(nil)
+        if !window.styleMask.contains(.fullScreen) {
+            window.toggleFullScreen(nil)
+        }
+        NSApp.presentationOptions = [.fullScreen]
+        DispatchQueue.main.asyncAfter(deadline: .now() + 0.35) { [weak self] in
+            self?.captureMouse()
+        }
+    }
+
+    func transitionAppShellToCompactWindow() {
+        guard let window = window else {
+            return
+        }
+        if let monitor = UTMAppShellRuntimeState.shared.keyGuardMonitor {
+            NSEvent.removeMonitor(monitor)
+            UTMAppShellRuntimeState.shared.keyGuardMonitor = nil
+        }
+        releaseMouse()
+        NSApp.presentationOptions = []
+        if window.styleMask.contains(.fullScreen) {
+            window.toggleFullScreen(nil)
+        }
+        window.title = UTMAppShellRuntimeState.windowTitle
+        window.titleVisibility = .visible
+        window.setContentSize(UTMAppShellRuntimeState.windowSize)
+        window.center()
+    }
+
+    func installAppShellKeyGuardIfNeeded() {
+        let runtime = UTMAppShellRuntimeState.shared
+        guard runtime.keyGuardMonitor == nil else {
+            return
+        }
+        runtime.keyGuardMonitor = NSEvent.addLocalMonitorForEvents(matching: [.keyDown, .keyUp]) { [weak self] event in
+            let flags = event.modifierFlags.intersection(.deviceIndependentFlagsMask)
+            if event.type == .keyDown,
+               flags.contains([.control, .command]),
+               !flags.contains(.option),
+               Int(event.keyCode) == kVK_ANSI_F {
+                DispatchQueue.main.async { [weak self] in
+                    self?.releaseMouse()
+                    self?.window?.toggleFullScreen(nil)
+                }
+                return nil
+            }
+            if event.type == .keyDown,
+               flags.contains([.option, .command]),
+               !flags.contains(.control),
+               Int(event.keyCode) == kVK_ANSI_Q {
+                DispatchQueue.main.async { [weak self] in
+                    self?.releaseMouse()
+                    self?.window?.performClose(nil)
+                }
+                return nil
+            }
+            let guardEnabled = ProcessInfo.processInfo.environment["UTM_GAME_SHELL_KEY_GUARD"]
+                .map { $0 == "1" } ?? true
+            guard guardEnabled, self?.window?.styleMask.contains(.fullScreen) == true else {
+                return event
+            }
+            if flags.contains(.command) && !flags.contains(.option) && !flags.contains(.control) {
+                switch Int(event.keyCode) {
+                case kVK_ANSI_W, kVK_ANSI_Q, kVK_ANSI_H, kVK_ANSI_M:
+                    return nil
+                default:
+                    break
+                }
+            }
+            return event
+        }
+    }
+
+    func handleAppShellSuspendedIfNeeded() {
+        guard UTMAppShellRuntimeState.isAppShellMode else {
+            return
+        }
+        if vm.state == .stopped {
+            stopAppShellStateMonitoring()
+            DispatchQueue.main.async {
+                NSApp.terminate(nil)
+            }
+        }
+    }
+}
