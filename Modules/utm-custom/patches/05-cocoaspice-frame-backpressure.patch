+    os_unfair_lock_lock(&_motion_lock);
+    dx = _pending_dx;
+    dy = _pending_dy;
+    mask = _pending_button_mask;
+    _pending_dx = 0.0;
+    _pending_dy = 0.0;
+    _motion_flush_scheduled = NO;
+    os_unfair_lock_unlock(&_motion_lock);
+
+    if (!self.channel || self.disableInputs) {
+        return;
+    }
+    if (!self.serverModeCursor) {
+        _residual_dx = 0.0;
+        _residual_dy = 0.0;
+        SPICE_DEBUG("[CocoaSpice] %s:%d ignoring mouse motion event since we are in client mode", __FUNCTION__, __LINE__);
