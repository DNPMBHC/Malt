+    gint sendY = (gint)trunc(totalY);
+    _residual_dx = totalX - (double)sendX;
+    _residual_dy = totalY - (double)sendY;
+    if (sendX != 0 || sendY != 0) {
+        spice_inputs_channel_motion(self.channel, sendX, sendY, cs_button_mask_to_spice(mask));
+    }
