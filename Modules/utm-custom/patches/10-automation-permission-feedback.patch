diff --git a/utmctl/UTMCtl.swift b/utmctl/UTMCtl.swift
index fa8e951..ba9ec71 100644
--- a/utmctl/UTMCtl.swift
+++ b/utmctl/UTMCtl.swift
@@ -159,8 +159,8 @@ extension UTMCtl {
             if let user = error.userInfo["ErrorString"] as? String {
                 FileHandle.standardError.write(user)
             }
-            if error.domain == NSOSStatusErrorDomain && error.code == errAEEventNotPermitted {
-                FileHandle.standardError.write("NOTE: utmctl does not work from SSH sessions or before logging in.")
+            if error.domain == NSOSStatusErrorDomain && (error.code == errAEEventNotPermitted || error.code == -1744) {
+                FileHandle.standardError.write("\nAUTOMATION_PERMISSION_DENIED (\(error.code)): Allow this app to control the bundled runtime engine in System Settings > Privacy & Security > Automation, then retry from the local logged-in desktop.\n")
             }
             return nil
         }
