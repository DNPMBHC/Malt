+
+    private var isGameShellFullScreenActive: Bool {
+        let isGameShell = CommandLine.arguments.contains("--game-shell-vm")
+            || ProcessInfo.processInfo.environment["UTM_GAME_SHELL_VM"] != nil
+        return isGameShell && (window?.styleMask.contains(.fullScreen) == true)
+    }
+
+    private var shouldGuardGameShellShortcuts: Bool {
+        isGameShellFullScreenActive
+            || ProcessInfo.processInfo.environment["UTM_GAME_SHELL_KEY_GUARD"] == "1"
+    }
+
+    private var shouldBlockLeftWinKey: Bool {
+        if let env = ProcessInfo.processInfo.environment["UTM_BLOCK_WIN_KEY"] {
+            return env == "1"
+        }
+        return isGameShellFullScreenActive
+    }
+
+    override func performKeyEquivalent(with event: NSEvent) -> Bool {
+        if shouldGuardGameShellShortcuts {
+            let flags = event.modifierFlags.intersection(.deviceIndependentFlagsMask)
+            if flags.contains(.command) && !flags.contains(.option) && !flags.contains(.control) {
+                switch Int(event.keyCode) {
+                case kVK_ANSI_W, kVK_ANSI_Q, kVK_ANSI_H, kVK_ANSI_M:
+                    logger.trace("blocked accidental game-shell shortcut keyCode=\(event.keyCode)")
+                    return true
+                default:
+                    break
+                }
+            }
+        }
+        return super.performKeyEquivalent(with: event)
+    }
     
