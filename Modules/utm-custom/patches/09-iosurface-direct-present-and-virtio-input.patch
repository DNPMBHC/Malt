             }
         }
 
+        // Phase 15A: enable zero-copy IOSurface direct present + 1:1 Metal blit fast path
+        // and guard default QEMURendererFPSLimit = 120 + triple buffering.
+        let directDisabled = ProcessInfo.processInfo.environment["UTM_IOSURFACE_DIRECT_PRESENT"] == "0"
+            || CommandLine.arguments.contains("--disable-iosurface-direct-present")
+        if !directDisabled {
+            metalView.framebufferOnly = false
+            if let layer = metalView.layer as? CAMetalLayer {
+                layer.framebufferOnly = false
+                if layer.maximumDrawableCount < 3 {
+                    layer.maximumDrawableCount = 3
+                }
+            }
+        }
+        if ProcessInfo.processInfo.environment["UTM_RENDER_FPS_LIMIT"] == nil && rendererFpsLimit <= 0 {
+            rendererFpsLimit = 120
+            updateFrameRate()
+        }
+
         if isSecondary && isDisplaySizeDynamic, let window = window {
